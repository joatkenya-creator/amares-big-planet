# Cloudflare Workers `_headers`.
#
# IMPORTANT: this file only applies to responses served directly from the
# static asset store. Server-rendered HTML is produced by the Worker and never
# passes through here — those headers, including the nonce-based CSP, are set
# in `src/start.ts`. Keep the two in sync when changing security policy.
#
# Rules are matched top-to-bottom; the most specific match wins.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Content-hashed build output — safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed static media — cache at the edge, revalidate in the browser daily.
/videos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Loose images in public/ (favicon, safcom). Patterns must start with `/` —
# a bare `*.png` is rejected by Wrangler as an invalid rule.
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.jpeg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
